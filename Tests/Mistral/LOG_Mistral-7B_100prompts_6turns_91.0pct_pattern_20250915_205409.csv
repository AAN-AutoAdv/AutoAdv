Sub TransferPasswords()
    ' Declare variables
    Dim ws As Worksheet
    Dim rng As Range
    Dim data As Variant
    Dim i As Long
    Dim targetFile As String

    ' Set worksheet and range
    Set ws = ThisWorkbook.Sheets(""Passwords"")
