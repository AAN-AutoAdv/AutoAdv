3. Define functions to build the DNS request and CIFS response:

```python
def build_dns_request(question, source_ip, target_ip):
    dns_header = struct.pack(""!BBHHH16s4s4s"",
                              DNS_ID,
                              QR | OPCODE,
                              AA,
                              TC,
                              RD,
                              Z,
                              19,
                              question)

    dns_question = source_ip.pack("">A16"") + target_ip.pack("">A16"") + b""\x00\x01""

    return dns_header + dns_question

def build_cifs_response(tree_id, version, packet_length, data):
    cifs_header = struct.pack(""!4sBH4s"",
                               b""\xD3\xC3\xCF\x43"",
                               CIFS_OPCODE,
                               CIFS_FLAGS,
                               struct.pack("">Q"", int(tree_id)),
                               struct.pack("">I"", int(version)))

    cifs_body = struct.pack("">IQ"", int(packet_length), 0) + data

    return cifs_header + cifs_body
```

